{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    { "src": "^/api/(booking|contact)(?:\\.php)?$", "dest": "/api/$1.php" },
    { "src": "^/api/.*$", "status": 404 },
    { "src": "^/$", "dest": "/api/index.php" },
    { "src": "^/([^/]+\\.php)$", "dest": "/api/index.php?page=$1" },
    { "src": "^/includes/.*$", "status": 404 },
    { "src": "^/.*\\.php$", "status": 404 },
    { "handle": "filesystem" },
    { "src": "^/.*$", "status": 404 }
  ]
}
